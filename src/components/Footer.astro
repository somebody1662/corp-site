---
import { SITE_TITLE, SITE_SLOGAN, SITE_PHONE, SITE_EMAIL, SITE_ADDRESS } from '../consts';
const today = new Date();
---

<footer>
	<div class="foot-inner">
		<p class="brand">{SITE_TITLE}</p>
		<p class="slogan">{SITE_SLOGAN}</p>
		<p class="contact">
			{SITE_PHONE !== '待补充' && <span>电话：{SITE_PHONE}</span>}
			{SITE_EMAIL !== '待补充' && <span>邮箱：{SITE_EMAIL}</span>}
			{SITE_ADDRESS !== '待补充' && <span>地址：{SITE_ADDRESS}</span>}
		</p>
		<hr />
		<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE} · 保安岗亭与民宿房屋定制专家</p>
		<p class="powered">由 Astro 静态生成 · 内容通过 Keystatic 管理</p>
	</div>
</footer>
<style>
	footer {
		padding: 2.5em 1em 3.5em 1em;
		border-top: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.85em;
	}
	.foot-inner {
		max-width: 720px;
		margin: 0 auto;
	}
	.brand {
		margin: 0 0 0.2em 0;
		color: rgb(var(--black));
		font-size: 1.1em;
		font-weight: 700;
	}
	.slogan {
		margin: 0 0 0.8em 0;
		font-family: Consolas, monospace;
		font-size: 0.85em;
		color: var(--accent);
		letter-spacing: 0.08em;
	}
	.contact {
		margin: 0 0 1em 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.4em 1.6em;
	}
	.contact span {
		font-family: Consolas, monospace;
		font-size: 0.92em;
	}
	.copy {
		margin: 0 0 0.3em 0;
	}
	.powered {
		margin: 0;
		font-family: Consolas, monospace;
		font-size: 0.85em;
	}
	hr {
		max-width: 220px;
		margin: 1.4em auto;
	}
</style>

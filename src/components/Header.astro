---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/products">产品</HeaderLink>
			<HeaderLink href="/cases">案例</HeaderLink>
			<HeaderLink href="/news">新闻</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
			<HeaderLink href="/contact">联系</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.2em;
		background: var(--paper);
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	h2 {
		margin: 0;
		font-size: 1.02em;
		white-space: nowrap;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		border-bottom: none;
		color: rgb(var(--black));
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		max-width: 1080px;
		margin: 0 auto;
	}
	nav a {
		padding: 0.9em 0.45em;
		color: rgb(var(--gray));
		border-bottom: 2px solid transparent;
		text-decoration: none;
		white-space: nowrap;
	}
	nav a:hover {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}
	nav a.active {
		color: rgb(var(--black));
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		overflow-x: auto;
	}
	@media (max-width: 720px) {
		header {
			padding: 0 0.6em;
		}
		h2 {
			font-size: 0.88em;
		}
		nav a {
			padding: 0.8em 0.4em;
			font-size: 0.92em;
		}
	}
</style>

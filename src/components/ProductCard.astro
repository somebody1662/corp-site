---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import placeholder from '../assets/blog-placeholder-1.jpg';

interface Props {
	product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { title, category, summary, cover, draft } = product.data;
---

<a class="card" href={`/products/${product.id}/`}>
	{cover ? (
		<Image class="cover" src={cover} alt={title} widths={[480, 720]} sizes="(max-width:720px) 100vw, 480px" />
	) : (
		<img class="cover" src={placeholder.src} alt={title} />
	)}
	<div class="body">
		<span class="tag">{category}</span>
		<h3>{title}</h3>
		<p>{summary}</p>
		<span class="more">查看详情 →</span>
	</div>
</a>
<style>
	.card {
		display: block;
		background: #fffdf9;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		overflow: hidden;
		text-decoration: none;
		border-bottom: none;
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}
	.card:hover {
		box-shadow: var(--box-shadow);
		transform: translateY(-2px);
	}
	.cover {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 0;
	}
	.body {
		padding: 1.1em 1.2em 1.2em;
	}
	h3 {
		margin: 0.4em 0 0.5em;
		font-size: 1.2em;
	}
	p {
		margin: 0 0 0.9em;
		font-size: 0.92em;
		color: rgb(var(--gray));
		line-height: 1.7;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.more {
		font-family: Consolas, monospace;
		font-size: 0.82em;
		color: var(--accent);
	}
	.card:hover .more {
		text-decoration: underline;
	}
</style>

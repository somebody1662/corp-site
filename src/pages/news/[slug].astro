---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
	const news = await getCollection('news');
	return news.filter((n) => !n.data.draft).map((n) => ({ params: { slug: n.id }, props: { item: n } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const { title, category, pubDate, summary, cover } = item.data;

const allNews = (await getCollection('news'))
	.filter((n) => !n.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const idx = allNews.findIndex((n) => n.id === item.id);
const prev = idx > 0 ? allNews[idx - 1] : null;
const next = idx < allNews.length - 1 ? allNews[idx + 1] : null;

const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description: summary,
	datePublished: pubDate.toISOString(),
	category,
});
---

<BaseLayout title={title} description={summary} image={cover ?? undefined} jsonLd={jsonLd}>
	<article>
		<header class="head">
			<span class="tag">{category}</span>
			<h1>{title}</h1>
			<p class="meta"><FormattedDate date={pubDate} /></p>
		</header>

		{cover && <Image class="hero-img" src={cover} alt={title} widths={[720, 1080]} sizes="(max-width:720px) 100vw, 1080px" />}

		<div class="prose body">
			<Content />
		</div>

		<nav class="pager">
			{prev ? (
				<a href={`/news/${prev.id}/`}>← {prev.data.title}</a>
			) : (
				<span />
			)}
			{next ? (
				<a href={`/news/${next.id}/`}>{next.data.title} →</a>
			) : (
				<span />
			)}
		</nav>
	</article>
</BaseLayout>

<style>
	.head {
		padding: 2em 0 1.2em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 1.4em;
	}
	.head h1 {
		margin: 0.4em 0 0.3em;
	}
	.meta {
		font-family: Consolas, monospace;
		font-size: 0.82em;
		color: var(--accent);
		margin: 0;
	}
	.hero-img {
		width: 100%;
		max-height: 420px;
		object-fit: cover;
		border-radius: 8px;
		margin-bottom: 1.6em;
	}
	.body {
		max-width: 720px;
	}
	.pager {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		margin-top: 2.4em;
		padding-top: 1.4em;
		border-top: 1px solid rgb(var(--gray-light));
		font-size: 0.92em;
	}
	.pager a {
		max-width: 45%;
	}
</style>

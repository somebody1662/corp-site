---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { SITE_TITLE } from '../../consts';
import placeholder from '../../assets/blog-placeholder-1.jpg';

export async function getStaticPaths() {
	const products = await getCollection('products');
	return products.filter((p) => !p.data.draft).map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const { title, category, summary, cover, gallery, specs, features } = product.data;

const allProducts = (await getCollection('products'))
	.filter((p) => !p.data.draft && p.id !== product.id && p.data.category === category)
	.sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: title,
	description: summary,
	category,
	brand: { '@type': 'Brand', name: SITE_TITLE },
	image: cover ? [new URL(cover.src, Astro.url).toString()] : undefined,
});
---

<BaseLayout title={title} description={summary} image={cover ?? undefined} jsonLd={jsonLd}>
	<article>
		<header class="head">
			<span class="tag">{category}</span>
			<h1>{title}</h1>
			<p class="summary">{summary}</p>
		</header>

		<div class="media">
			{cover ? (
				<Image class="hero-img" src={cover} alt={title} widths={[720, 1080]} sizes="(max-width:720px) 100vw, 1080px" />
			) : (
				<img class="hero-img" src={placeholder.src} alt={title} />
			)}
			{gallery.length > 0 && (
				<div class="gallery">
					{gallery.map((g) => <Image src={g} alt={title} widths={[360, 540]} />)}
				</div>
			)}
		</div>

		<div class="detail">
			<section class="prose">
				<Content />
			</section>

			<aside class="side">
				{specs.length > 0 && (
					<div class="specs">
						<h2>规格参数</h2>
						<table>
							<tbody>
								{specs.map((s) => (
									<tr>
										<th>{s.label}</th>
										<td>{s.value}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				)}

				{features.length > 0 && (
					<div class="features">
						<h2>核心卖点</h2>
						<ul>
							{features.map((f) => <li>{f}</li>)}
						</ul>
					</div>
				)}

				<a class="btn" href="/contact/">获取报价 →</a>
			</aside>
		</div>
	</article>

	{allProducts.length > 0 && (
		<section class="related">
			<h2>同类产品</h2>
			<div class="card-grid">
				{allProducts.slice(0, 3).map((p) => <ProductCard product={p} />)}
			</div>
		</section>
	)}
</BaseLayout>

<style>
	.head {
		padding: 2em 0 1.2em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 1.4em;
	}
	.head h1 {
		margin: 0.4em 0 0.4em;
	}
	.summary {
		color: rgb(var(--gray));
		font-size: 1.05em;
		margin: 0;
	}
	.hero-img {
		width: 100%;
		max-height: 480px;
		object-fit: cover;
		border-radius: 8px;
	}
	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 0.8em;
		margin-top: 0.8em;
	}
	.gallery img {
		border-radius: 6px;
	}
	.detail {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 320px;
		gap: 2.4em;
		margin-top: 2em;
	}
	.side {
		border-left: 1px solid rgb(var(--gray-light));
		padding-left: 1.6em;
	}
	.side h2 {
		font-size: 1.1em;
		margin-top: 0;
	}
	.features {
		margin-top: 1.6em;
	}
	.features li {
		margin-bottom: 0.5em;
	}
	.btn {
		display: inline-block;
		margin-top: 1.8em;
		padding: 0.7em 1.6em;
		background: var(--accent);
		color: #fff;
		border-radius: 4px;
		text-decoration: none;
		border-bottom: none;
	}
	.btn:hover {
		background: var(--accent-dark);
	}
	.related {
		margin-top: 3em;
		padding-top: 1.6em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.4em;
	}
	@media (max-width: 720px) {
		.detail {
			grid-template-columns: 1fr;
		}
		.side {
			border-left: none;
			padding-left: 0;
			border-top: 1px solid rgb(var(--gray-light));
			padding-top: 1.4em;
		}
	}
</style>

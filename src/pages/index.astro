---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import CaseCard from '../components/CaseCard.astro';
import NewsCard from '../components/NewsCard.astro';
import { SITE_TITLE, SITE_SLOGAN, SITE_DESCRIPTION } from '../consts';
import placeholderBooth from '../assets/blog-placeholder-1.jpg';
import placeholderCabin from '../assets/blog-placeholder-3.jpg';

const products = (await getCollection('products')).filter((p) => !p.data.draft).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const cases = (await getCollection('cases')).filter((c) => !c.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const news = (await getCollection('news')).filter((n) => !n.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	slogan: SITE_SLOGAN,
});
---

<BaseLayout jsonLd={jsonLd}>
	<section class="hero">
		<p class="kicker">DONGGUAN · CHINA</p>
		<h1>{SITE_TITLE}</h1>
		<p class="slogan">{SITE_SLOGAN}</p>
		<p class="intro">{SITE_DESCRIPTION}</p>
		<div class="cta">
			<a class="btn" href="/products/">查看产品</a>
			<a class="btn ghost" href="/contact/">联系我们</a>
		</div>
	</section>

	<section class="section">
		<p class="kicker">PRODUCT LINES</p>
		<h2>两大产品线</h2>
		<div class="line-grid">
			<a class="line" href="/products/?cat=保安岗亭">
				<img src={placeholderBooth.src} alt="保安岗亭" />
				<div class="line-body">
					<span class="tag">保安岗亭</span>
					<h3>小区 · 园区 · 工厂出入口值守</h3>
					<p>不锈钢岗亭、智能收费岗亭，支持尺寸与配置定制。</p>
					<span class="more">查看岗亭产品 →</span>
				</div>
			</a>
			<a class="line" href="/products/?cat=民宿房屋">
				<img src={placeholderCabin.src} alt="民宿房屋" />
				<div class="line-body">
					<span class="tag">民宿房屋</span>
					<h3>景区 · 营地 · 乡村民宿快速落地</h3>
					<p>集装箱民宿、移动木屋，工厂预制、现场吊装。</p>
					<span class="more">查看民宿产品 →</span>
				</div>
			</a>
		</div>
	</section>

	<section class="section">
		<p class="kicker">PRODUCTS</p>
		<h2>精选产品</h2>
		<div class="card-grid">
			{products.slice(0, 4).map((p) => <ProductCard product={p} />)}
		</div>
		<p class="more-link"><a href="/products/">全部产品 →</a></p>
	</section>

	<section class="section">
		<p class="kicker">CASES</p>
		<h2>项目案例</h2>
		<div class="card-grid">
			{cases.slice(0, 3).map((c) => <CaseCard item={c} />)}
		</div>
		<p class="more-link"><a href="/cases/">全部案例 →</a></p>
	</section>

	<section class="section">
		<p class="kicker">NEWS</p>
		<h2>新闻动态</h2>
		<div class="news-list">
			{news.slice(0, 3).map((n) => <NewsCard item={n} />)}
		</div>
		<p class="more-link"><a href="/news/">全部新闻 →</a></p>
	</section>

	<section class="cta-section">
		<h2>需要定制方案？</h2>
		<p>从需求沟通、方案设计到生产安装，一站式服务。</p>
		<a class="btn" href="/contact/">获取报价</a>
	</section>
</BaseLayout>

<style>
	.hero {
		text-align: center;
		padding: 3.2em 1em 2.4em;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.kicker {
		font-family: Consolas, monospace;
		font-size: 0.78em;
		letter-spacing: 0.22em;
		color: var(--accent);
		margin-bottom: 1em;
	}
	.hero h1 {
		margin: 0 0 0.3em;
		font-size: 2.6em;
	}
	.slogan {
		font-family: Consolas, monospace;
		font-size: 0.92em;
		letter-spacing: 0.14em;
		color: var(--accent);
		margin: 0 0 1.2em;
	}
	.intro {
		max-width: 560px;
		margin: 0 auto 1.8em;
		color: rgb(var(--gray));
		font-size: 1.02em;
	}
	.cta {
		display: flex;
		justify-content: center;
		gap: 1em;
		flex-wrap: wrap;
	}
	.btn {
		display: inline-block;
		padding: 0.7em 1.8em;
		background: var(--accent);
		color: #fff;
		border-radius: 4px;
		text-decoration: none;
		border-bottom: none;
		font-size: 0.95em;
	}
	.btn:hover {
		background: var(--accent-dark);
	}
	.btn.ghost {
		background: transparent;
		color: var(--accent);
		border: 1px solid var(--accent);
	}
	.btn.ghost:hover {
		background: var(--accent);
		color: #fff;
	}

	.section {
		padding: 2.6em 0 1.4em;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.section h2 {
		margin: 0 0 1.2em;
	}
	.line-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.4em;
	}
	.line {
		display: block;
		background: #fffdf9;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		overflow: hidden;
		text-decoration: none;
		border-bottom: none;
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}
	.line:hover {
		box-shadow: var(--box-shadow);
		transform: translateY(-2px);
	}
	.line img {
		width: 100%;
		aspect-ratio: 16 / 7;
		object-fit: cover;
		border-radius: 0;
	}
	.line-body {
		padding: 1.2em 1.3em 1.3em;
	}
	.line-body h3 {
		margin: 0.5em 0 0.5em;
		font-size: 1.15em;
	}
	.line-body p {
		margin: 0 0 0.9em;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	.more {
		font-family: Consolas, monospace;
		font-size: 0.82em;
		color: var(--accent);
	}
	.line:hover .more {
		text-decoration: underline;
	}

	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.4em;
	}
	.more-link {
		margin: 1.4em 0 0;
		text-align: right;
		font-family: Consolas, monospace;
		font-size: 0.85em;
	}
	.news-list {
		max-width: 760px;
	}

	.cta-section {
		text-align: center;
		padding: 3em 1em;
	}
	.cta-section h2 {
		margin: 0 0 0.4em;
	}
	.cta-section p {
		color: rgb(var(--gray));
		margin: 0 0 1.4em;
	}

	@media (max-width: 720px) {
		.hero h1 {
			font-size: 1.8em;
		}
		.line-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import placeholder from '../../assets/blog-placeholder-2.jpg';

export async function getStaticPaths() {
	const cases = await getCollection('cases');
	return cases.filter((c) => !c.data.draft).map((c) => ({ params: { slug: c.id }, props: { item: c } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const { title, category, client, location, date, summary, cover } = item.data;

const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description: summary,
	datePublished: date.toISOString(),
});
---

<BaseLayout title={title} description={summary} image={cover ?? undefined} jsonLd={jsonLd}>
	<article>
		<header class="head">
			<span class="tag">{category}</span>
			<h1>{title}</h1>
			<p class="meta">
				{client && <span>{client}</span>}
				{location && <span>{location}</span>}
				<span><FormattedDate date={date} /></span>
			</p>
			<p class="summary">{summary}</p>
		</header>

		{cover && <Image class="hero-img" src={cover} alt={title} widths={[720, 1080]} sizes="(max-width:720px) 100vw, 1080px" />}
		{!cover && <img class="hero-img" src={placeholder.src} alt={title} />}

		<div class="prose body">
			<Content />
		</div>

		<div class="cta">
			<a class="btn" href="/contact/">想做类似项目？联系我们 →</a>
		</div>
	</article>
</BaseLayout>

<style>
	.head {
		padding: 2em 0 1.2em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 1.4em;
	}
	.head h1 {
		margin: 0.4em 0 0.3em;
	}
	.meta {
		font-family: Consolas, monospace;
		font-size: 0.82em;
		color: var(--accent);
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.2em;
		margin: 0 0 0.8em;
	}
	.summary {
		color: rgb(var(--gray));
		font-size: 1.05em;
		margin: 0;
	}
	.hero-img {
		width: 100%;
		max-height: 480px;
		object-fit: cover;
		border-radius: 8px;
		margin-bottom: 1.6em;
	}
	.body {
		max-width: 720px;
	}
	.cta {
		margin-top: 2.4em;
		padding-top: 1.6em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.btn {
		display: inline-block;
		padding: 0.7em 1.6em;
		background: var(--accent);
		color: #fff;
		border-radius: 4px;
		text-decoration: none;
		border-bottom: none;
	}
	.btn:hover {
		background: var(--accent-dark);
	}
</style>

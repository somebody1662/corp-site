---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';

const cases = (await getCollection('cases'))
	.filter((c) => !c.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = ['岗亭项目', '民宿项目'];
---

<BaseLayout title="项目案例" description="森度智能项目案例：保安岗亭与民宿房屋的落地交付记录。" jsonLd={JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: '项目案例',
})}>
	<header class="page-head">
		<p class="kicker">CASES</p>
		<h1>项目案例</h1>
		<p>从方案到交付，让每个项目说话</p>
	</header>

	<nav class="tabs" aria-label="案例分类">
		<button class="tab-btn active" data-cat="all">全部</button>
		{categories.map((c) => <button class="tab-btn" data-cat={c}>{c}</button>)}
	</nav>

	<div class="card-grid">
		{cases.map((c) => (
			<div data-category={c.data.category} style="display:block">
				<CaseCard item={c} />
			</div>
		))}
	</div>

	<script>
		const tabs = document.querySelectorAll('.tab-btn');
		const cards = document.querySelectorAll('[data-category]');
		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const cat = tab.dataset.cat;
				tabs.forEach((t) => t.classList.toggle('active', t === tab));
				cards.forEach((card) => {
					card.style.display = cat === 'all' || card.dataset.category === cat ? '' : 'none';
				});
			});
		});
	</script>
</BaseLayout>

<style>
	.page-head {
		padding: 2.2em 0 1.2em;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.kicker {
		font-family: Consolas, monospace;
		font-size: 0.78em;
		letter-spacing: 0.22em;
		color: var(--accent);
		margin-bottom: 0.6em;
	}
	.page-head h1 {
		margin: 0 0 0.2em;
	}
	.page-head p {
		margin: 0;
		color: rgb(var(--gray));
	}
	.tabs {
		display: flex;
		gap: 0.6em;
		padding: 1.4em 0 0.6em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 1.6em;
	}
	.tab-btn {
		font-family: Consolas, monospace;
		font-size: 0.88em;
		padding: 0.45em 1.2em;
		background: var(--tag-bg);
		color: rgb(var(--gray-dark));
		border: 1px solid rgb(var(--gray-light));
		border-radius: 3px;
		cursor: pointer;
	}
	.tab-btn.active {
		background: var(--accent);
		color: #fff;
		border-color: var(--accent);
	}
	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.4em;
		padding-bottom: 2em;
	}
</style>

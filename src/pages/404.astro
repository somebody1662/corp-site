---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="404 Not Found">
	<section class="notfound">
		<h1>404</h1>
		<p>这里什么都没有。</p>
		<p><a href="/">回到首页</a></p>
	</section>
</BaseLayout>

<style>
	.notfound {
		text-align: center;
		padding: 4em 0;
	}
	.notfound h1 {
		font-size: 4em;
		margin: 0 0 0.2em 0;
		color: var(--accent);
	}
	.notfound p {
		color: rgb(var(--gray));
	}
</style>
